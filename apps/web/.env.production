# Production values for the Rent Ghar web app (public, committed — no secrets here).
# Leave NEXT_PUBLIC_API_URL unset on the server: the app then calls the relative
# path /api, which is proxied to the API on the same domain.
NEXT_PUBLIC_BASE_URL=https://rentghar.pk
NEXT_PUBLIC_SITE_URL=https://rentghar.pk
NODE_ENV=production
